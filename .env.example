# ==============================================================================
# TVB Agentic Company Lead Discovery - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual API keys.
# NEVER commit your actual .env file to version control.

# Primary LLM Provider (Groq provides high-throughput inference)
GROQ_API_KEY=your_groq_api_key_here

# Autonomous Web Search Provider (Tavily or Serper)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Alternative LLM Providers
OPENAI_API_KEY=your_openai_api_key_here_optional
GEMINI_API_KEY=your_gemini_api_key_here_optional

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
