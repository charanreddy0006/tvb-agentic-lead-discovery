*.py[cod]
*.pyc
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example
*.env.local

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated runtime outputs & candidate export files (preserve directory via .gitkeep)
data/*.json
data/*.csv
!data/.gitkeep
